{
  "name": "api",
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "build": "vite build",
    "preview": "$npm_execpath run build && vite preview",
    "deploy": "$npm_execpath run build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:test": "wrangler d1 migrations apply DB --local --config wrangler.test.jsonc",
    "db:migrate:prod": "wrangler d1 migrations apply DB --remote",
    "db:seed": "tsx src/db/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@cloudflare-ec-app/library": "workspace:*",
    "@cloudflare-ec-app/types": "workspace:*",
    "@hono/zod-validator": "^0.7.4",
    "@libsql/client": "^0.15.15",
    "drizzle-orm": "^0.44.7",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.10.3",
    "ulid": "^3.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.2.3",
    "@faker-js/faker": "^10.1.0",
    "@vitest/ui": "^4.0.6",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.5",
    "miniflare": "^4.20251202.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "vite-ssr-components": "^0.5.1",
    "vitest": "^4.0.6",
    "wrangler": "^4.17.0"
  }
}